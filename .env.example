# --- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:replace-me
# Supergroup with topics enabled, e.g. -1001234567890
TELEGRAM_CHAT_ID=-1001234567890
# message_thread_id of the topic to post in (see README)
TELEGRAM_TOPIC_ID=2
# Comma-separated Telegram user IDs allowed to run admin commands
ADMIN_IDS=111111111,222222222

# --- Pushover -------------------------------------------------------------
PUSHOVER_APP_TOKEN=replace-me

# --- Security -------------------------------------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Storage / endpoints (defaults shown) ----------------------------------
DB_PATH=/data/monitor.db
BINANCE_FAPI_URL=https://fapi.binance.com
BINANCE_FSTREAM_URL=wss://fstream.binance.com
PUSHOVER_API_URL=https://api.pushover.net
TELEGRAM_API_URL=https://api.telegram.org

# --- Tuning ---------------------------------------------------------------
PINNED_REFRESH_SECONDS=60
RECONCILE_SECONDS=300
LOG_LEVEL=INFO
HEARTBEAT_PATH=/data/heartbeat

# Only used by deploy/docker-compose.prod.yml (docker compose interpolation)
# IMAGE=ghcr.io/<owner>/binance-monitor:latest
